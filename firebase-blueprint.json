{
  "entities": {
    "profile": {
      "title": "RT Profile",
      "description": "The profile data of the RT neighborhood block",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "rtNumber": { "type": "string" },
        "rwNumber": { "type": "string" },
        "subdistrict": { "type": "string" },
        "district": { "type": "string" },
        "city": { "type": "string" },
        "chairpersonName": { "type": "string" },
        "treasurerName": { "type": "string" },
        "secretaryName": { "type": "string" },
        "adminPin": { "type": "string" },
        "officers": { "type": "array" },
        "programKerjaList": { "type": "array" },
        "bankName": { "type": "string" },
        "bankAccountNo": { "type": "string" },
        "bankAccountHolder": { "type": "string" },
        "bankTransferNote": { "type": "string" }
      },
      "required": ["name", "rtNumber", "rwNumber", "subdistrict", "district", "city", "chairpersonName", "treasurerName", "secretaryName", "adminPin"]
    },
    "resident": {
      "title": "Resident Record",
      "description": "Details of a house/resident in the RT, including arrears and dues payments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "houseNo": { "type": "string" },
        "name": { "type": "string" },
        "isVacant": { "type": "boolean" },
        "customMonthlyRate": { "type": "number" },
        "arrearsAmount": { "type": "number" },
        "arrearsStatusText": { "type": "string" },
        "payments": { "type": "object" },
        "phone": { "type": "string" },
        "notes": { "type": "string" },
        "nik": { "type": "string" },
        "kkNumber": { "type": "string" },
        "spouseName": { "type": "string" },
        "spouseNik": { "type": "string" },
        "children": { "type": "array" },
        "otherFamilyMembers": { "type": "array" },
        "houseStatus": { "type": "string" },
        "totalOccupants": { "type": "number" }
      },
      "required": ["id", "houseNo", "name", "isVacant", "arrearsAmount", "payments"]
    },
    "transaction": {
      "title": "Cash Transaction",
      "description": "A ledger transaction of the RT cashbook",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "recordedBy": { "type": "string" },
        "receiptNumber": { "type": "string" },
        "referenceId": { "type": "string" },
        "notes": { "type": "string" },
        "attachmentName": { "type": "string" },
        "attachmentUrl": { "type": "string" }
      },
      "required": ["id", "date", "type", "category", "description", "amount", "recordedBy"]
    },
    "debt": {
      "title": "Debt Item",
      "description": "An outstanding debt or receivable of the RT block",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "personName": { "type": "string" },
        "contact": { "type": "string" },
        "amount": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "date": { "type": "string" },
        "dueDate": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string" },
        "payments": { "type": "array" }
      },
      "required": ["id", "type", "personName", "amount", "remainingAmount", "date", "status", "payments"]
    },
    "syncState": {
      "title": "Google Sync State",
      "description": "Metadata about Google Sheets synchronization",
      "type": "object",
      "properties": {
        "spreadsheetId": { "type": "string" },
        "spreadsheetUrl": { "type": "string" },
        "lastSyncedAt": { "type": "string" },
        "syncInProgress": { "type": "boolean" },
        "statusMessage": { "type": "string" }
      },
      "required": ["syncInProgress"]
    },
    "incidentalDues": {
      "title": "Incidental Dues Program",
      "description": "An incidental one-off dues program tracking payments of each resident",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "description": { "type": "string" },
        "payments": { "type": "object" }
      },
      "required": ["id", "title", "amount", "date", "payments"]
    }
  },
  "firestore": {
    "/profile/{profileId}": {
      "schema": "profile",
      "description": "Store individual profile details"
    },
    "/residents/{residentId}": {
      "schema": "resident",
      "description": "Store information for each house and its dues payments"
    },
    "/transactions/{transactionId}": {
      "schema": "transaction",
      "description": "Ledger of RT cashbook entries"
    },
    "/debts/{debtId}": {
      "schema": "debt",
      "description": "Outstanding debts or receivables"
    },
    "/syncState/{stateId}": {
      "schema": "syncState",
      "description": "Store Google synchronization status"
    },
    "/incidentalDues/{incidentalId}": {
      "schema": "incidentalDues",
      "description": "Store individual incidental dues programs"
    }
  }
}
